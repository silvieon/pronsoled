[Unit]
Description=pronsoled - persistent Printrun pronsole daemon
Documentation=https://github.com/silvieon/pronsoled

[Service]
# The daemon reports ready once the printer is online and its socket is listening,
# so `systemctl start` returns when `pronsoled status` works, or fails with the reason.
Type=notify
# Unprivileged user created by install.sh, in the serial group for printer access.
User=pronsoled
# /run/pronsoled holds the socket: members of the pronsoled group may use it.
# setgid, so print jobs they stage there stay readable by the daemon.
RuntimeDirectory=pronsoled
RuntimeDirectoryMode=2770
Environment=PRONSOLED_CONFIG_DIR=/run/pronsoled
ExecStart=/usr/local/bin/pronsoled start auto 115200
# Keep retrying, e.g. until the printer is plugged in or switched back on.
Restart=on-failure
RestartSec=10
# SIGTERM goes to pronsoled only; it stops pronsole itself.
KillMode=mixed

[Install]
WantedBy=multi-user.target

[Unit]
Description=pronsoled - persistent Printrun pronsole daemon
Documentation=https://github.com/silvieon/pronsoled
After=local-fs.target

[Service]
Type=simple
# Unprivileged system user created by install.sh. It is added to the serial
# group (dialout/uucp) so it can open the printer.
User=pronsoled
Group=pronsoled
# /run/pronsoled holds the socket; members of the pronsoled group can use it.
# setgid so print jobs staged there by clients stay readable by the daemon.
RuntimeDirectory=pronsoled
RuntimeDirectoryMode=2770
StateDirectory=pronsoled
LogsDirectory=pronsoled
UMask=0007
WorkingDirectory=/var/lib/pronsoled
Environment=HOME=/var/lib/pronsoled
Environment=PRONSOLED_CONFIG_DIR=/run/pronsoled
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/local/bin/pronsoled start auto 115200 --log-file /var/log/pronsoled/pronsoled.log
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=10
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

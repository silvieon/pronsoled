[Unit]
Description=Pronsoled - stable wrapper around Printrun pronsole
After=local-fs.target
Documentation=https://github.com/YOUR_USERNAME/pronsoled

[Service]
Type=simple
User=root
Environment=PRONSOLED_CONFIG_DIR=/var/lib/pronsoled
WorkingDirectory=/var/lib/pronsoled
ExecStart=/usr/local/bin/pronsoled start auto 115200
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
